{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Debug LoRaWAN_End_Node_ADR (ST-LINK GDB server)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/LoRaWAN_End_Node_ADR.elf"
                }
            ]
        },
        {
            "type": "stlinkgdbtarget",
            "request": "attach",
            "name": "STM32Cube: Attach to running LoRaWAN_End_Node_ADR (no reset)",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/Debug/LoRaWAN_End_Node_ADR.elf"
                }
            ]
        }
    ]
}
